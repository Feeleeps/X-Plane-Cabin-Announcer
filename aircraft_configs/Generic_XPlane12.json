{
  "name": "Generic X-Plane 12 Airliner",
  "author": "X-Plane Cabin Announcer",
  "description": "Universal configuration using standard X-Plane 12 datarefs.",
  "aircraft_icao_match": ["B738", "A333", "MD82", "B744", "A320"],
  "triggers": {
    "BoardingWelcome": {
      "when": [
        "sim/flightmodel/failures/onground_any == 1",
        "sim/cockpit2/controls/parking_brake_ratio >= 0.8",
        "sim/cockpit2/switches/beacon_on == 0"
      ],
      "delay": 6
    },
    "ArmDoors": {
      "when": [
        "sim/flightmodel/failures/onground_any == 1",
        "sim/cockpit2/switches/beacon_on -> 1"
      ],
      "delay": 2
    },
    "SafetyBriefing": {
      "when": [
        "sim/flightmodel/failures/onground_any == 1",
        "sim/flightmodel/position/groundspeed > 1.5",
        "sim/cockpit2/switches/beacon_on == 1"
      ],
      "delay": 4
    },
    "CrewSeatsTakeoff": {
      "when": [
        "sim/flightmodel/failures/onground_any == 1",
        "sim/flightmodel/position/groundspeed > 7.5"
      ],
      "delay": 2
    },
    "AfterTakeoff": {
      "when": [
        "sim/flightmodel/failures/onground_any == 0",
        "sim/flightmodel/position/y_agl climbs_past 457.2"
      ],
      "delay": 5
    },
    "TopOfClimbPilot": {
      "when": [
        "sim/flightmodel/failures/onground_any == 0",
        "sim/flightmodel/position/elevation climbs_past 3048.0"
      ],
      "delay": 8
    },
    "FastenSeatbelt": {
      "when": [
        "sim/flightmodel/failures/onground_any == 0",
        "sim/flightmodel/position/y_agl > 1500.0",
        "sim/cockpit2/switches/fasten_seat_belts -> 1"
      ],
      "delay": 1,
      "cooldown": 60,
      "repeat": true
    },
    "TopOfDescentPilot": {
      "when": [
        "sim/flightmodel/failures/onground_any == 0",
        "sim/flightmodel/position/elevation descends_past 3048.0"
      ],
      "delay": 5
    },
    "Descent": {
      "when": [
        "sim/flightmodel/failures/onground_any == 0",
        "sim/flightmodel/position/y_agl descends_past 762.0"
      ],
      "delay": 3
    },
    "AfterLanding": {
      "when": [
        "sim/flightmodel/failures/onground_any == 1",
        "sim/flightmodel/position/groundspeed < 15.0"
      ],
      "delay": 4
    },
    "DisarmDoors": {
      "when": [
        "sim/flightmodel/failures/onground_any == 1",
        "sim/cockpit2/controls/parking_brake_ratio >= 0.8",
        "sim/cockpit2/switches/beacon_on -> 0"
      ],
      "delay": 3
    }
  }
}
