{
  "name": "Zibo Mod Boeing 737-800",
  "author": "X-Plane Cabin Announcer",
  "description": "Cabin announcement triggers using Zibo 737 custom datarefs and standard systems.",
  "aircraft_icao_match": ["B738"],
  "rules": [
    {
      "id": "zibo_boarding",
      "sound_name": "BoardingWelcome",
      "description": "Boarding welcome when parked at gate",
      "conditions": [
        { "dataref": "sim/flightmodel/failures/onground_any", "op": "==", "value": 1.0 },
        { "dataref": "sim/cockpit2/controls/parking_brake_ratio", "op": ">=", "value": 0.9 },
        { "dataref": "sim/cockpit2/switches/beacon_on", "op": "==", "value": 0.0 }
      ],
      "delay_seconds": 6,
      "once_per_flight": true
    },
    {
      "id": "zibo_arm_doors",
      "sound_name": "ArmDoors",
      "description": "Arm doors call when beacon light is switched ON for pushback",
      "conditions": [
        { "dataref": "sim/flightmodel/failures/onground_any", "op": "==", "value": 1.0 },
        { "dataref": "sim/cockpit2/switches/beacon_on", "op": "transition_to", "value": 1.0 }
      ],
      "delay_seconds": 2,
      "once_per_flight": true
    },
    {
      "id": "zibo_safety_briefing",
      "sound_name": "SafetyBriefing",
      "description": "Safety briefing during taxi",
      "conditions": [
        { "dataref": "sim/flightmodel/failures/onground_any", "op": "==", "value": 1.0 },
        { "dataref": "sim/flightmodel/position/groundspeed", "op": ">", "value": 1.5 },
        { "dataref": "sim/cockpit2/switches/beacon_on", "op": "==", "value": 1.0 }
      ],
      "delay_seconds": 4,
      "once_per_flight": true
    },
    {
      "id": "zibo_crew_seats_takeoff",
      "sound_name": "CrewSeatsTakeoff",
      "description": "Cabin crew seats for takeoff",
      "conditions": [
        { "dataref": "sim/flightmodel/failures/onground_any", "op": "==", "value": 1.0 },
        { "dataref": "sim/flightmodel/position/groundspeed", "op": ">", "value": 8.0 }
      ],
      "delay_seconds": 2,
      "once_per_flight": true
    },
    {
      "id": "zibo_after_takeoff",
      "sound_name": "AfterTakeoff",
      "description": "After takeoff announcement climbing past 1,500 ft AGL",
      "conditions": [
        { "dataref": "sim/flightmodel/failures/onground_any", "op": "==", "value": 0.0 },
        { "dataref": "sim/flightmodel/position/y_agl", "op": "increased_past", "value": 457.2 }
      ],
      "delay_seconds": 4,
      "once_per_flight": true
    },
    {
      "id": "zibo_top_of_climb",
      "sound_name": "TopOfClimbPilot",
      "description": "Captain announcement climbing past 10,000 ft MSL",
      "conditions": [
        { "dataref": "sim/flightmodel/failures/onground_any", "op": "==", "value": 0.0 },
        { "dataref": "sim/flightmodel/position/elevation", "op": "increased_past", "value": 3048.0 }
      ],
      "delay_seconds": 8,
      "once_per_flight": true
    },
    {
      "id": "zibo_fasten_seatbelts",
      "sound_name": "FastenSeatbelt",
      "description": "Seatbelt sign switched ON in cruise",
      "conditions": [
        { "dataref": "sim/flightmodel/failures/onground_any", "op": "==", "value": 0.0 },
        { "dataref": "sim/flightmodel/position/y_agl", "op": ">", "value": 1500.0 },
        { "dataref": "sim/cockpit2/switches/fasten_seat_belts", "op": "transition_to", "value": 1.0 }
      ],
      "delay_seconds": 1,
      "cooldown_seconds": 60,
      "once_per_flight": false
    },
    {
      "id": "zibo_top_of_descent",
      "sound_name": "TopOfDescentPilot",
      "description": "Captain announcement descending past 10,000 ft MSL",
      "conditions": [
        { "dataref": "sim/flightmodel/failures/onground_any", "op": "==", "value": 0.0 },
        { "dataref": "sim/flightmodel/position/elevation", "op": "decreased_past", "value": 3048.0 }
      ],
      "delay_seconds": 5,
      "once_per_flight": true
    },
    {
      "id": "zibo_after_landing",
      "sound_name": "AfterLanding",
      "description": "After landing welcome when decelerating on runway",
      "conditions": [
        { "dataref": "sim/flightmodel/failures/onground_any", "op": "==", "value": 1.0 },
        { "dataref": "sim/flightmodel/position/groundspeed", "op": "<", "value": 15.0 }
      ],
      "delay_seconds": 3,
      "once_per_flight": true
    },
    {
      "id": "zibo_disarm_doors",
      "sound_name": "DisarmDoors",
      "description": "Disarm doors when beacon turned off and parked at gate",
      "conditions": [
        { "dataref": "sim/flightmodel/failures/onground_any", "op": "==", "value": 1.0 },
        { "dataref": "sim/cockpit2/controls/parking_brake_ratio", "op": ">=", "value": 0.9 },
        { "dataref": "sim/cockpit2/switches/beacon_on", "op": "transition_to", "value": 0.0 }
      ],
      "delay_seconds": 2,
      "once_per_flight": true
    }
  ]
}
