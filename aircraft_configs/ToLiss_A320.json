{
  "name": "ToLiss A320 Family (A319/A320/A321)",
  "author": "X-Plane Cabin Announcer",
  "aircraft_icao_match": ["A319", "A320", "A321"],
  "triggers": {
    "BoardingWelcome": {
      "when": [
        "sim/flightmodel/failures/onground_any == 1",
        "AirbusFBW/ParkBrake >= 0.9",
        "AirbusFBW/BeaconLightsOn == 0"
      ],
      "delay": 6
    },
    "ArmDoors": {
      "when": [
        "sim/flightmodel/failures/onground_any == 1",
        "AirbusFBW/BeaconLightsOn -> 1"
      ],
      "delay": 2
    },
    "SafetyBriefing": {
      "when": [
        "sim/flightmodel/failures/onground_any == 1",
        "sim/flightmodel/position/groundspeed > 1.5",
        "AirbusFBW/BeaconLightsOn == 1"
      ],
      "delay": 4
    },
    "CrewSeatsTakeoff": {
      "when": [
        "sim/flightmodel/failures/onground_any == 1",
        "AirbusFBW/StrobeLightsOn -> 2"
      ],
      "delay": 2
    },
    "AfterTakeoff": {
      "when": [
        "sim/flightmodel/failures/onground_any == 0",
        "sim/flightmodel/position/y_agl climbs_past 457.2"
      ],
      "delay": 4
    },
    "TopOfClimbPilot": {
      "when": [
        "sim/flightmodel/failures/onground_any == 0",
        "sim/flightmodel/position/elevation climbs_past 3048"
      ],
      "delay": 8
    },
    "FastenSeatbelt": {
      "when": [
        "sim/flightmodel/failures/onground_any == 0",
        "sim/flightmodel/position/y_agl > 1500",
        "AirbusFBW/SeatBeltSignsOn -> 1"
      ],
      "delay": 1,
      "cooldown": 60,
      "repeat": true
    },
    "TopOfDescentPilot": {
      "when": [
        "sim/flightmodel/failures/onground_any == 0",
        "sim/flightmodel/position/elevation descends_past 3048"
      ],
      "delay": 5
    },
    "AfterLanding": {
      "when": [
        "sim/flightmodel/failures/onground_any == 1",
        "sim/flightmodel/position/groundspeed < 15.0"
      ],
      "delay": 3
    },
    "DisarmDoors": {
      "when": [
        "sim/flightmodel/failures/onground_any == 1",
        "AirbusFBW/ParkBrake >= 0.9",
        "AirbusFBW/BeaconLightsOn -> 0"
      ],
      "delay": 2
    }
  }
}
