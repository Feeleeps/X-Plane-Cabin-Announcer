{
  "name": "Generic X-Plane 12 Airliner",
  "author": "X-Plane Cabin Announcer",
  "description": "Universal configuration using standard X-Plane 12 datarefs.",
  "aircraft_icao_match": ["B738", "A333", "MD82", "B744", "A320"],
  "hardware_mappings": {
    "pa_volume_dataref": "sim/cockpit2/radios/actuators/audio_volume_com1",
    "pa_volume_index": 0,
    "cabin_call_annunciator_dataref": "",
    "cabin_ready_command": ""
  },
  "triggers": {
    "BoardingWelcome": {
      "when": [
        "sim/flightmodel/failures/onground_any == 1",
        "sim/cockpit2/controls/parking_brake_ratio >= 0.8",
        "sim/cockpit2/switches/beacon_on == 0"
      ],
      "delay": 6
    },
    "ArmDoors": {
      "when": [
        "sim/flightmodel/failures/onground_any == 1",
        "sim/cockpit2/switches/beacon_on -> 1"
      ],
      "delay": 2
    },
    "SafetyBriefing": {
      "when": [
        "sim/flightmodel/failures/onground_any == 1",
        "sim/flightmodel/position/groundspeed > 1.5",
        "sim/cockpit2/switches/beacon_on == 1"
      ],
      "delay": 4
    },
    "CrewSeatsTakeoff": {
      "when": [
        "sim/flightmodel/failures/onground_any == 1",
        "sim/flightmodel/position/groundspeed > 7.5"
      ],
      "delay": 2
    },
    "AfterTakeoff": {
      "when": [
        "sim/flightmodel/failures/onground_any == 0",
        "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot climbs_past 1500"
      ],
      "delay": 5
    },

    "FastenSeatbelt": {
      "when": [
        "sim/flightmodel/failures/onground_any == 0",
        "sim/cockpit2/gauges/indicators/altitude_ft_pilot > 5000",
        "sim/cockpit2/switches/fasten_seat_belts -> 1"
      ],
      "delay": 1,
      "cooldown": 60,
      "repeat": true
    },
    "DescentSeatbelts": {
      "when": [
        "sim/flightmodel/failures/onground_any == 0",
        "sim/cockpit2/gauges/indicators/altitude_ft_pilot descends_past 10000"
      ],
      "delay": 5
    },
    "AfterLanding": {
      "when": [
        "played DescentSeatbelts",
        "sim/flightmodel/failures/onground_any == 1",
        "sim/flightmodel/position/groundspeed < 15.0"
      ],
      "delay": 4
    },
    "DisarmDoors": {
      "when": [
        "sim/flightmodel/failures/onground_any == 1",
        "sim/cockpit2/controls/parking_brake_ratio >= 0.8",
        "sim/cockpit2/switches/beacon_on -> 0"
      ],
      "delay": 3
    }
  }
}
