{
  "name": "Zibo Mod Boeing 737-800",
  "author": "X-Plane Cabin Announcer",
  "aircraft_icao_match": ["B738"],
  "triggers": {
    "BoardingWelcome": {
      "when": [
        "sim/flightmodel/failures/onground_any == 1",
        "sim/cockpit2/controls/parking_brake_ratio >= 0.9",
        "sim/cockpit2/switches/beacon_on == 0"
      ],
      "delay": 6
    },
    "ArmDoors": {
      "when": [
        "sim/flightmodel/failures/onground_any == 1",
        "sim/cockpit2/switches/beacon_on -> 1"
      ],
      "delay": 2
    },
    "SafetyBriefing": {
      "when": [
        "sim/flightmodel/failures/onground_any == 1",
        "sim/flightmodel/position/groundspeed > 1.5",
        "sim/cockpit2/switches/beacon_on == 1"
      ],
      "delay": 4
    },
    "CrewSeatsTakeoff": {
      "when": [
        "sim/flightmodel/failures/onground_any == 1",
        "sim/flightmodel/position/groundspeed > 8.0"
      ],
      "delay": 2
    },
    "AfterTakeoff": {
      "when": [
        "sim/flightmodel/failures/onground_any == 0",
        "sim/flightmodel/position/y_agl climbs_past 457.2"
      ],
      "delay": 4
    },
    "TopOfClimbPilot": {
      "when": [
        "sim/flightmodel/failures/onground_any == 0",
        "sim/flightmodel/position/elevation climbs_past 3048"
      ],
      "delay": 8
    },
    "FastenSeatbelt": {
      "when": [
        "sim/flightmodel/failures/onground_any == 0",
        "sim/flightmodel/position/y_agl > 1500",
        "sim/cockpit2/switches/fasten_seat_belts -> 1"
      ],
      "delay": 1,
      "cooldown": 60,
      "repeat": true
    },
    "TopOfDescentPilot": {
      "when": [
        "sim/flightmodel/failures/onground_any == 0",
        "sim/flightmodel/position/elevation descends_past 3048"
      ],
      "delay": 5
    },
    "AfterLanding": {
      "when": [
        "sim/flightmodel/failures/onground_any == 1",
        "sim/flightmodel/position/groundspeed < 15.0"
      ],
      "delay": 3
    },
    "DisarmDoors": {
      "when": [
        "sim/flightmodel/failures/onground_any == 1",
        "sim/cockpit2/controls/parking_brake_ratio >= 0.9",
        "sim/cockpit2/switches/beacon_on -> 0"
      ],
      "delay": 2
    }
  }
}
